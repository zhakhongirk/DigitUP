# PostgreSQL connection string
DATABASE_URL=postgres://storefront:storefront@localhost:5432/storefront

# LLM provider (any OpenAI-compatible API, e.g. Meta Model API: https://api.meta.ai/v1, model muse-spark-1.3)
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Reasoning models: minimal, low, medium, high, xhigh or max (sent as reasoning_effort); empty sends nothing
LLM_REASONING_EFFORT=
# Extra tokens added to every request's max_tokens so reasoning does not consume the visible answer
LLM_REASONING_TOKENS=0
# Legacy aliases, used only when the LLM_* value is empty
FIREWORKS_API_KEY=
FIREWORKS_MODEL=
FIREWORKS_BASE_URL=
# Tool calling mode for server/llm: "native" or "json" (use the value recommended by `pnpm llm:probe`)
LLM_TOOL_CALL_MODE=native

# Session signing secret: any long random string
AUTH_SECRET=

# Folder for uploaded onboarding files; the app and the worker must share it
STORAGE_DIR=storage

# Public base URL of the app
APP_URL=http://localhost:3000

# Set to 1 to turn off rate limiting on public endpoints
RATE_LIMIT_DISABLED=

# Number of reverse proxies in front of the app; the client IP is taken that many hops from the right of X-Forwarded-For
TRUST_PROXY_HOPS=

# Log verbosity: debug, info, warn or error (default info)
# LOG_LEVEL=info

# IANA time zone for dates shown to owners and buyers (default Asia/Almaty)
# APP_TIMEZONE=Asia/Almaty

# Telegram bot for owner notifications (create one with @BotFather); both values are needed
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Outgoing mail for password reset and staff invites; when SMTP_HOST is empty the link is written to the log instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
